size_flags_horizontal = 3

[node name="LifeMode" type="MenuButton" parent="Margin/Stack/Nav" unique_id=1219067915]
layout_mode = 2
size_flags_vertical = 4
flat = false

; 窗头这一行 2026-10-08 起只有三颗：域标签 / 生活模式 / 搜索。
; 原来这里还有第四颗 —— 一颗只管开画廊的「预设生活模式…」常驻按钮，
; 而「预设生活模式…」**本来就已经在生活模式那颗钮的菜单下半**（Options.RefreshLifeModeMenu
; 那一发）。所以那一颗是同一个动作的第二个入口，两颗并排摆着。
; 所有者定：合并成一颗 —— 留着菜单里那一条，删掉这颗常驻按钮（入口少一个，
; 而这一个动作一个入口也不该少，它还在）。
;
; 判据在 Presets.EntriesSelfTest（那一组量的正是「画廊的两处入口」），
; 那里同步记着这次合并：它原先量的是「窗头那颗 + 菜单那一项」，现在量的是
; 「菜单里那一条 + 管理器上那颗」—— 两处入口还在（契约「画廊的入口在
; 生活模式管理器和设置窗」），而设置窗那一处从一颗常驻钮变成菜单里那一条。

